---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/locales';
import { getUpdateImage } from '../lib/images';
import { pick, youTubeId, youTubeThumbnail, type UpdateEntry } from '../data/updates';

interface Props {
  entry: UpdateEntry;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const img = getUpdateImage(entry.image);
const title = pick(entry.title, lang);
const category = pick(entry.category, lang);
const excerpt = pick(entry.excerpt, lang);
const date = pick(entry.date, lang);
const videoId = youTubeId(entry.video);
---

<article class="update-card">
  <div class="update-card-media">
    {img ? (
      <Image src={img} alt={title} widths={[400, 600]} sizes="(max-width: 700px) 90vw, 380px" loading="lazy" />
    ) : videoId ? (
      <a
        class="update-card-video"
        href={entry.video}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={title}
      >
        <img src={youTubeThumbnail(videoId)} alt={title} loading="lazy" width="1280" height="720" />
        <span class="update-card-play" aria-hidden="true"></span>
      </a>
    ) : entry.link ? (
      <a class="update-card-placeholder is-link" href={entry.link} target="_blank" rel="noopener noreferrer" aria-label={title}>
        {entry.source && <span class="update-card-source">{entry.source}</span>}
      </a>
    ) : (
      <div class="update-card-placeholder" aria-hidden="true">
        {entry.source && <span class="update-card-source">{entry.source}</span>}
      </div>
    )}
  </div>
  <div class="update-card-body">
    <span class="category">{category}</span>
    <h3>{entry.link ? <a href={entry.link} target="_blank" rel="noopener noreferrer">{title}</a> : title}</h3>
    <p>{excerpt}</p>
    <p class="date">{date}</p>
  </div>
</article>
