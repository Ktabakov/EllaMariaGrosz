---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { locales, isLocale, type Locale } from '../../i18n/locales';
import { getMessages } from '../../i18n';
import { getUpdateImage } from '../../lib/images';
import {
  exhibitions,
  exhibitionTypeLabel,
  pickLocalized,
  viewsForExhibition,
  ungroupedViews,
  exhibitionsWithViews,
} from '../../data/exhibitions';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: langParam } = Astro.params;
if (!isLocale(langParam ?? '')) {
  return Astro.redirect('/en/exhibitions');
}
const lang = langParam as Locale;
const m = getMessages(lang);

const withImg = (list: ReturnType<typeof viewsForExhibition>) =>
  list.map((v) => ({ ...v, img: getUpdateImage(v.image) })).filter((v) => v.img);

// Photos grouped per exhibition (like the PDF), then a closing gallery.
const groupedViews = exhibitionsWithViews().map((ex) => ({
  exhibition: ex,
  views: withImg(viewsForExhibition(ex.id!)),
}));
const extraViews = withImg(ungroupedViews());

// A hero image for the top of the page: prefer the opening shot.
const heroView = groupedViews.flatMap((g) => g.views)[0] ?? extraViews[0];
---

<Layout lang={lang} title={m.exhibitionsPage.title} description={m.exhibitionsPage.description}>

    {heroView && (
        <section class="exhibitions-hero">
            <Image src={heroView.img!} alt={pickLocalized(heroView.caption, lang)} widths={[900, 1400, 1920]} sizes="100vw" loading="eager" class="exhibitions-hero-image" />
            <div class="exhibitions-hero-overlay"></div>
            <div class="container exhibitions-hero-content">
                <p class="hero-kicker">{m.nav.exhibitions}</p>
                <h1 class="exhibitions-hero-title">{m.exhibitionsPage.viewsTitle}</h1>
                <p class="exhibitions-hero-name">Ella Maria Groß</p>
            </div>
        </section>
    )}

    <section class="portfolio-page exhibitions-page">
        <div class="container">
            <header class="page-head">
                {!heroView && <h1>{m.exhibitionsPage.heading}</h1>}
                <p class="page-intro">{m.exhibitionsPage.intro}</p>
            </header>

            <h2 class="exhibition-list-heading">{m.exhibitionsPage.listHeading}</h2>
            <ol class="exhibition-list">
                {exhibitions.map((ex) => (
                    <li class="exhibition-row">
                        <span class="exhibition-year">
                            {ex.month && <span class="exhibition-month">{ex.month}</span>}
                            <span class="exhibition-year-num">{ex.year}</span>
                        </span>
                        <span class="exhibition-detail">
                            <span class="exhibition-type">{pickLocalized(exhibitionTypeLabel[ex.type], lang)}</span>
                            <span class="exhibition-title">{ex.title}</span>
                            <span class="exhibition-venue">
                                {ex.venue}{ex.city ? `, ${ex.city}` : ''}
                            </span>
                        </span>
                    </li>
                ))}
            </ol>

            {(groupedViews.length > 0 || extraViews.length > 0) && (
                <section class="selected-views" aria-labelledby="views-heading">
                    <h2 id="views-heading" class="views-section-heading">{m.exhibitionsPage.viewsHeading}</h2>

                    {groupedViews.map(({ exhibition: ex, views }) => (
                        <div class="view-group">
                            <h3 class="view-group-heading">
                                <span class="view-group-year">{ex.year}</span>
                                <span class="view-group-type">{pickLocalized(exhibitionTypeLabel[ex.type], lang)}</span>
                                <span class="view-group-title">{ex.title}</span>
                                <span class="view-group-venue">{ex.venue}{ex.city ? `, ${ex.city}` : ''}</span>
                            </h3>
                            <div class="views-masonry">
                                {views.map((v) => (
                                    <figure class="view-item">
                                        <Image src={v.img!} alt={pickLocalized(v.caption, lang)} widths={[400, 700, 1000]} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 360px" loading="lazy" />
                                        <figcaption>{pickLocalized(v.caption, lang)}</figcaption>
                                    </figure>
                                ))}
                            </div>
                        </div>
                    ))}

                    {extraViews.length > 0 && (
                        <div class="view-group">
                            <h3 class="view-group-heading">
                                <span class="view-group-title">{m.exhibitionsPage.moreViews}</span>
                            </h3>
                            <div class="views-masonry">
                                {extraViews.map((v) => (
                                    <figure class="view-item">
                                        <Image src={v.img!} alt={pickLocalized(v.caption, lang)} widths={[400, 700, 1000]} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 360px" loading="lazy" />
                                        <figcaption>{pickLocalized(v.caption, lang)}</figcaption>
                                    </figure>
                                ))}
                            </div>
                        </div>
                    )}
                </section>
            )}
        </div>
    </section>

</Layout>

<style>
    /* ---- Title hero (like the PDF cover) ---- */
    .exhibitions-hero {
        position: relative;
        min-height: min(62vh, 560px);
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        background: var(--surface-alt);
        margin-bottom: clamp(2rem, 5vw, 3.5rem);
    }
    .exhibitions-hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }
    .exhibitions-hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.15) 55%, rgba(0,0,0,0.25) 100%);
    }
    .exhibitions-hero-content {
        position: relative;
        z-index: 2;
        padding-top: 3rem;
        padding-bottom: 2.5rem;
        color: #fff;
    }
    .exhibitions-hero-content .hero-kicker { color: rgba(255,255,255,0.85); }
    .exhibitions-hero-title {
        font-size: clamp(2rem, 5vw, 3.6rem);
        line-height: 1.05;
        max-width: 18ch;
        color: #fff;
        text-shadow: 0 2px 24px rgba(0,0,0,0.4);
        margin-bottom: 0.6rem;
    }
    .exhibitions-hero-name {
        font-size: clamp(1rem, 2vw, 1.3rem);
        font-weight: 300;
        color: rgba(255,255,255,0.92);
        letter-spacing: 0.02em;
    }

    .exhibitions-page .page-head {
        margin-bottom: 2.5rem;
        text-align: left;
    }

    .exhibition-list-heading {
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.6;
        margin: 0 0 1rem;
    }

    .exhibition-list {
        list-style: none;
        margin: 0 0 4rem;
        padding: 0;
        border-top: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    }

    .exhibition-row {
        display: grid;
        grid-template-columns: 7.5rem 1fr;
        gap: 1.25rem;
        padding: 1.1rem 0;
        border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    }

    .exhibition-year {
        display: flex;
        flex-direction: column;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
        white-space: nowrap;
    }

    .exhibition-month {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        opacity: 0.6;
    }

    .exhibition-year-num {
        font-weight: 600;
        opacity: 0.85;
    }

    .exhibition-detail {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .exhibition-type {
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        opacity: 0.6;
    }

    .exhibition-title {
        font-weight: 600;
    }

    .exhibition-venue {
        opacity: 0.75;
    }

    .views-section-heading {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        margin-bottom: 2rem;
    }

    /* ---- Each show gets its own heading + photo block (like the PDF) ---- */
    .view-group {
        margin-bottom: clamp(2.5rem, 6vw, 4rem);
    }

    .view-group-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 0.7rem;
        font-size: 1.05rem;
        font-weight: 400;
        padding-bottom: 0.7rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    }
    .view-group-year { font-weight: 700; font-variant-numeric: tabular-nums; }
    .view-group-type {
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.6;
    }
    .view-group-title { font-weight: 600; }
    .view-group-venue { opacity: 0.7; }

    /* ---- Masonry "tetris" packing so mixed aspect ratios sit flush ---- */
    .views-masonry {
        column-count: 3;
        column-gap: 1.1rem;
    }

    .view-item {
        margin: 0 0 1.1rem;
        break-inside: avoid;
    }

    .view-item :global(img) {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 4px;
        background: var(--muted, rgba(0, 0, 0, 0.04));
    }

    .view-item figcaption {
        margin-top: 0.4rem;
        font-size: 0.82rem;
        opacity: 0.65;
    }

    @media (max-width: 900px) {
        .views-masonry { column-count: 2; }
    }

    @media (max-width: 540px) {
        .exhibition-row {
            grid-template-columns: 5.5rem 1fr;
            gap: 0.9rem;
        }
        .views-masonry { column-count: 1; }
    }
</style>
